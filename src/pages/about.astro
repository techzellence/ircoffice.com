---
// Editorial copy reviewed in October 2026; keep factual claims aligned with current services.
import BaseLayout from '../layouts/BaseLayout.astro';
import { FOUNDED_YEAR } from '../lib/business';
---

<BaseLayout
  title="About Immigrant Resource Center | Minneapolis"
  description="Meet Immigrant Resource Center, an immigrant-owned Minneapolis business helping families prepare immigration and travel paperwork since 1999."
  canonical="https://ircoffice.com/about"
>
  <!--website hero image-->
  <header class="header header-flexbox">
    <div class="container-main">
      <div class="header__main-area" style="justify-content: center;">
        <div class="header-flexbox-content">
          <h1 class="heading__primary--greencard align-middle my-25">
            <span class="secondary-color-text">About Immigrant Resource Center</span>
          </h1>
        </div>
      </div>
    </div>
  </header>

  <!--section who we are-->
  <section class="section-greencard-definition">
    <h2 class="heading__section align-middle my-15">Who we are</h2>
    <p class="paragraph-section align-middle my-30 max-width-600">
      Immigrant Resource Center is an immigrant-owned, family-run business serving Minneapolis since {FOUNDED_YEAR}. We help individuals and families prepare immigration forms, organize supporting records, and arrange travel.
    </p>
    <p class="paragraph-section align-middle my-30 max-width-600">
      You’ll find us on West Lake Street. Contact our office to discuss the paperwork you need help with, the cost of preparation, and what to bring.
    </p>
  </section>

  <!--section what we help with-->
  <section class="section-greencard__services">
    <h2 class="heading__section align-middle my-15">What we help with</h2>
    <p class="paragraph-section align-middle my-20 max-width-600">
      We assist individuals and families with the preparation and organization of immigration and
      travel paperwork, including:
    </p>
    <ul class="green-card green-card--list my-35">
      <li><strong>Green Card</strong> applications and supporting forms</li>
      <li><strong>Citizenship and naturalization</strong> applications</li>
      <li><strong>Visa</strong> applications, including family and visitor visas</li>
      <li><strong>USCIS form preparation</strong> and document organization</li>
      <li>
        <strong>Umrah travel assistance</strong> — ask about current visa, flight, and accommodation services
      </li>
    </ul>
    <p class="paragraph-section align-middle my-30 max-width-600">
      We explain the preparation steps, help organize your documents, and review forms for
      completeness at your direction. For legal advice about your situation, consult an immigration
      attorney or accredited representative.
    </p>
  </section>

  <!--section how we work-->
  <section class="section-why-choose">
    <h2 class="heading__section align-middle my-15" style="margin-bottom: 4rem;">
      How we work
    </h2>
    <div class="facility-container">
      <div class="facility__card">
        <h3 class="facility__heading align-middle my-20">Local and approachable</h3>
        <p class="facility__pargraph align-middle my-20">
          Our office is part of the community we serve. Ask about language support when you contact us.
        </p>
      </div>

      <div class="facility__card">
        <h3 class="facility__heading align-middle my-20">Clear about the work</h3>
        <p class="facility__pargraph align-middle my-20">
          We keep our pricing straightforward and explain what each service involves before you
          commit.
        </p>
      </div>

      <div class="facility__card">
        <h3 class="facility__heading align-middle my-20">A team you can reach</h3>
        <p class="facility__pargraph align-middle my-20">
          Call or send us a message to ask about our services and discuss the preparation work you need.
        </p>
      </div>
    </div>
  </section>

  <!--section important notice (verbatim, legally load-bearing; deliberate reinforcement of the
      Footer's global Disclaimer, not a duplication to remove)-->
  <section class="section-greencard-definition" style="padding-top: 8rem; padding-bottom: 8rem;">
    <h2 class="heading__section align-middle my-15">Important notice</h2>
    <p class="paragraph-section align-middle my-30 max-width-600">
      Immigrant Resource Center is a private entity that is registered in Minnesota and provides
      professional immigration and travel services at your direction. We are not a law firm or a
      substitute for an attorney or law firm, and we are not affiliated with USCIS or any government
      agency. We do not provide legal advice. Your access to and use of this site is subject to
      additional Terms of Use.
    </p>
  </section>

  <!--section visit us-->
  <section class="section-greencard__services" style="padding-bottom: 10rem;">
    <h2 class="heading__section align-middle my-15">Visit us</h2>
    <ul class="green-card green-card--list my-35">
      <li><strong>Address:</strong> 1 W Lake St Ste #165, Minneapolis, MN 55408</li>
      <li><strong>Phone:</strong> (612) 822-5747</li>
      <li><strong>Hours:</strong> Monday–Friday 9am–6pm, Saturday 10am–5pm</li>
    </ul>
    <p class="align-middle"><a href="/contact" class="btn btn--blue">Plan your visit or ask a question</a></p>
  </section>
</BaseLayout>

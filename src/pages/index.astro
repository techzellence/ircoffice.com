---
// Ported from the legacy index.html body (nav/footer/forms/map extracted to
// components in Tasks 4-6). Task 7 landed this as a static port with no client
// behaviour wired up; Task 8 wires it all: scroll animations and the notification
// banners (src/scripts/animation.ts, imported globally from BaseLayout), the
// testimonials carousel (src/scripts/carousel.ts, imported below), and the service
// tabs (src/components/Tabs.astro, wrapping the tab markup in this file). The
// vendored npm packages (gsap, swiper) replace the removed CDN scripts and the deleted
// flextabs plugin.
//
// Section id rename (cross-task interface, see Nav.astro): the legacy
// `id="who-are-we"` / `id="why-us"` become `id="WhoAreWe"` / `id="WhyUs"` to
// match the anchors Nav/Footer already link to (`/#WhoAreWe`, `/#WhyUs`).
import ConsultForm from '../components/ConsultForm.astro';
import Map from '../components/Map.astro';
import Tabs from '../components/Tabs.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { FOUNDED_YEAR, getYearsInBusiness } from '../lib/business';

const years = getYearsInBusiness();
---

<BaseLayout
  title="Immigration & Travel Help in Minneapolis | IRC"
  description="Immigration form preparation and travel assistance in Minneapolis. Get help with green card, citizenship, and visa paperwork. Call (612) 822-5747."
  canonical="https://www.ircoffice.com/"
>
  <!--website hero image with form-->
  <header class="header-2 header--home">
    <div class="header-home__content header__home--animation flex-center">
      <h1 class="heading__primary align-middle my-25">
        <span class="secondary-color-text">Immigration application help</span> in Minneapolis
      </h1>
      <p class="header__paragraph align-middle my-25">
        Get practical help preparing immigration forms and organizing supporting documents. Our
        Minneapolis team also assists with visas and travel arrangements.
      </p>
      <a href="#WhyUs" class="btn btn--primary btn--animated">Learn More</a>
    </div>
  </header>

  <section class="section section__form">
    <div
      class="form-box form__home--animation"
      style="box-shadow: rgba(0, 0, 0, 0.25) 0 3px 11px 0;"
    >
      <h2 class="heading-form align-middle my-20">ASK OUR TEAM</h2>
      <p class="paragraph-form align-middle my-30">
        Tell us what you need help with, and we will explain our application preparation services.
      </p>
      <ConsultForm subject="Consultation" formId="form__consultation" variant="orange" />
    </div>
  </section>
  <div class="divider"></div>

  <!--section services of the company-->

  <section class="section section-services">
    <h2 class="heading__section align-middle my-15">OUR SERVICES</h2>
    <p class="paragraph-section align-middle my-20">
      Immigration paperwork can be difficult to organize. With {years} years of experience, we help
      individuals and families prepare forms, gather documents, and understand the filing steps.
      Contact us to discuss the scope and cost of the help you need.
    </p>

    <div class="divider-image align-middle my-40">
      <img src="/img/Divider-Decorative_01.png" alt="" class="decorative-divider" />
    </div>

    <div class="service__information-table">
<div class="service-grid-title cc-2-column"><div class="title-1 cc-title">Service</div><div class="title-1 cc-title">Related form</div></div>
<div class="service-features"><div class="service-name">Naturalization and citizenship documentation</div><div class="service-form-no">N-400 / N-600</div></div>
<div class="service-features"><div class="service-name">Adjustment of status</div><div class="service-form-no">I-485</div></div>
<div class="service-features"><div class="service-name">Green card renewal or replacement</div><div class="service-form-no">I-90</div></div>
<div class="service-features"><div class="service-name">Removal of conditions on residence</div><div class="service-form-no">I-751</div></div>
<div class="service-features"><div class="service-name">Employment authorization</div><div class="service-form-no">I-765</div></div>
<div class="service-features"><div class="service-name">Family petitions</div><div class="service-form-no">I-130</div></div>
<div class="service-features"><div class="service-name">Fiancé(e) petitions</div><div class="service-form-no">I-129F</div></div>
<div class="service-features"><div class="service-name">Affidavit of support</div><div class="service-form-no">I-864</div></div>
<div class="service-features"><div class="service-name">Change of address</div><div class="service-form-no">AR-11</div></div>
<div class="service-features"><div class="service-name">Visa and travel paperwork</div><div class="service-form-no">Depends on destination</div></div>
<div class="service-features"><div class="service-name">Notary services and passport photos</div><div class="service-form-no">Contact us</div></div>
          </div>
  </section>

  <!--section services of the company End-->

  <!--tab layout-->

  <section class="section section-greencard__services">
    <Tabs>
    <div class="tab-wrapper">
      <nav class="tabammount_4 tab-sticky">
        <a href="#tab-1" class="flextabs__toggle tab-name align-middle active">Green Card</a>
        <a href="#tab-2" class="flextabs__toggle tab-name align-middle">Citizenship</a>
        <a href="#tab-3" class="flextabs__toggle tab-name align-middle">Visa</a>
        <a href="#tab-4" class="flextabs__toggle tab-name align-middle">Umrah Travel</a>
      </nav>
      <div class="all-tab-content-holder">
        <!--Tab 1 content  Start-->
        <div id="tab-1" class="tab-content-wrapper">
            <h3 class="heading__tab my-25">Green card application assistance</h3><p class="my-35 tab-paragraph">We help organize forms and supporting documents for green card applications, renewals, replacements, and removal of conditions. The paperwork depends on your application category and circumstances.</p><p class="my-35 tab-paragraph">A green card documents lawful permanent resident status. It is different from U.S. citizenship; naturalization is a separate process with its own eligibility requirements.</p><a href="/green-card" class="btn btn--blue btn--animated">Explore green card services</a>
          </div>

        <!--Tab 1 content  End-->

        <!--Tab 2 content  Start-->
        <div id="tab-2" class="tab-content-wrapper">
            <h3 class="heading__tab my-25">Citizenship and naturalization</h3><p class="my-35 tab-paragraph">Preparing to apply for U.S. citizenship? We can help organize your Form N-400 and supporting documents, and assist with citizenship documentation for children.</p><p class="my-35 tab-paragraph">Eligibility depends on your individual circumstances. Review the official requirements before filing, and consult an immigration attorney or accredited representative if you need advice about eligibility.</p><a href="/citizenship" class="btn btn--blue btn--animated">Explore citizenship services</a>
          </div>

        <!--Tab 2 Content End-->

        <!--Tab 3 Content Start-->
        <div id="tab-3" class="tab-content-wrapper">
            <h3 class="heading__tab my-25">Visa application assistance</h3><p class="my-35 tab-paragraph">Travel plans often involve more than booking a ticket. We help prepare paperwork for family-related, visitor, and international visa applications.</p><p class="my-35 tab-paragraph">Requirements depend on your destination, nationality, and purpose of travel. Government agencies decide applications and processing times; our role is to help with preparation.</p><a href="/visa" class="btn btn--blue btn--animated">Explore visa services</a>
          </div>
        <!--Tab 3  Content End-->

        <!--Tab 4 Content Start-->
        <div id="tab-4" class="tab-content-wrapper">
            <h3 class="heading__tab my-25">Umrah travel assistance</h3><p class="my-35 tab-paragraph">Planning an Umrah trip? Contact our Minneapolis office about visa paperwork, flights, accommodation, and the travel support currently available.</p><p class="my-35 tab-paragraph">Package availability, prices, and entry requirements can change. Confirm the arrangements and current requirements before booking.</p><a href="/umra" class="btn btn--blue btn--animated">Explore Umrah travel</a>
          </div>
        <!--Tab 4 Content End-->
      </div>
    </div>
    </Tabs>
  </section>

  <!--Why Choose Us-->

  <section class="section section-why-choose" id="WhyUs">
    <h2 class="heading__section align-middle my-15">WHY CHOOSE US</h2>
    <p class="paragraph-section--2 align-middle" style="margin-bottom: 60px;">
      Get practical support with your forms and documents from a local team you can reach.
    </p>
    <!--facility card 1-->
    <div class="facility-container">
      <div class="facility__card">
        <div class="shape-container align-middle">
          <svg width="70px" height="auto" viewBox="0.00 0.00 100 100" id="1735524544">
            <g>
              <path
                d="M40.8,3.7c13-5.7,30-5.3,40.2,4.7c4.2,4.1,6.9,9.6,8.4,15.2c3.3,12.1,4.3,24.6,3,37.1C91.3,71,88.7,84.5,81.3,92.3
			c-10.6,11.2-26.6,8.5-39.3,2.5c-5.2-2.5-10.2-5.4-14.9-8.7c-9-6.2-16.5-13.7-19.1-24.6C5.6,51.7,7.9,41.7,12.6,33
			C17.5,24,24,16,31.7,9.3C34.5,7,37.5,5.1,40.8,3.7z"
                style="fill:rgba(23, 65, 113, 1);"></path>
            </g>
          </svg>

          <h3 class="shape-text">1</h3>
        </div>

        <h4 class="facility__heading align-middle my-20">Responsive</h4>
        <p class="facility__pargraph align-middle my-20">
          We explain the paperwork preparation process, answer questions about our services, and
          keep you informed about the work we do for you.
        </p>
        <div class="arrow-icon align-middle">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 70 70"
            id="1479741662"
            class="svg-right"
            data-icon-name="ar-arrow_long_right"
          >
            <g id="1195287121">
              <g id="1944156141">
                <g id="1684418092">
                  <g id="1295127915">
                    <polygon
                      points="48.3,26.8 46.9,28.2 54.2,35 46.9,41.8 48.3,43.2 57.1,35 				"
                      id="1332565205"></polygon>
                  </g>
                </g>
              </g>
              <g id="1887052297">
                <rect x="12.9" y="34" width="42.2" height="2" id="1823810323"></rect>
              </g>
            </g>
          </svg>
        </div>
      </div>

      <!--facility card 2-->
      <div class="facility__card">
        <div class="shape-container align-middle">
          <svg width="70px" height="auto" viewBox="0.00 0.00 100 100" id="1735524544">
            <g>
              <path
                d="M40.8,3.7c13-5.7,30-5.3,40.2,4.7c4.2,4.1,6.9,9.6,8.4,15.2c3.3,12.1,4.3,24.6,3,37.1C91.3,71,88.7,84.5,81.3,92.3
			c-10.6,11.2-26.6,8.5-39.3,2.5c-5.2-2.5-10.2-5.4-14.9-8.7c-9-6.2-16.5-13.7-19.1-24.6C5.6,51.7,7.9,41.7,12.6,33
			C17.5,24,24,16,31.7,9.3C34.5,7,37.5,5.1,40.8,3.7z"
                style="fill:rgba(23, 65, 113, 1);"></path>
            </g>
          </svg>

          <h3 class="shape-text">2</h3>
        </div>
        <h4 class="facility__heading align-middle my-20">Affordable</h4>
        <p class="facility__pargraph align-middle my-20">
          Ask about the cost of preparing your paperwork before you begin. Government filing fees
          and any other charges are separate from our service fees.
        </p>
        <div class="arrow-icon align-middle">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 70 70"
            id="1479741662"
            class="svg-right"
            data-icon-name="ar-arrow_long_right"
          >
            <g id="1195287121">
              <g id="1944156141">
                <g id="1684418092">
                  <g id="1295127915">
                    <polygon
                      points="48.3,26.8 46.9,28.2 54.2,35 46.9,41.8 48.3,43.2 57.1,35 				"
                      id="1332565205"></polygon>
                  </g>
                </g>
              </g>
              <g id="1887052297">
                <rect x="12.9" y="34" width="42.2" height="2" id="1823810323"></rect>
              </g>
            </g>
          </svg>
        </div>
      </div>

      <!--facility card 3-->
      <div class="facility__card">
        <div class="shape-container align-middle">
          <svg width="70px" height="auto" viewBox="0.00 0.00 100 100" id="1735524544">
            <g>
              <path
                d="M40.8,3.7c13-5.7,30-5.3,40.2,4.7c4.2,4.1,6.9,9.6,8.4,15.2c3.3,12.1,4.3,24.6,3,37.1C91.3,71,88.7,84.5,81.3,92.3
			c-10.6,11.2-26.6,8.5-39.3,2.5c-5.2-2.5-10.2-5.4-14.9-8.7c-9-6.2-16.5-13.7-19.1-24.6C5.6,51.7,7.9,41.7,12.6,33
			C17.5,24,24,16,31.7,9.3C34.5,7,37.5,5.1,40.8,3.7z"
                style="fill:rgba(23, 65, 113, 1);"></path>
            </g>
          </svg>

          <h3 class="shape-text">3</h3>
        </div>
        <h4 class="facility__heading align-middle my-20">Experience</h4>
        <p class="facility__pargraph align-middle my-20">
          Our multilingual team has helped clients prepare immigration paperwork for {years} years.
          Ask us about language support when you contact the office.
        </p>
        <div class="arrow-icon align-middle">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 70 70"
            id="1479741662"
            class="svg-right"
            data-icon-name="ar-arrow_long_right"
          >
            <g id="1195287121">
              <g id="1944156141">
                <g id="1684418092">
                  <g id="1295127915">
                    <polygon
                      points="48.3,26.8 46.9,28.2 54.2,35 46.9,41.8 48.3,43.2 57.1,35 				"
                      id="1332565205"></polygon>
                  </g>
                </g>
              </g>
              <g id="1887052297">
                <rect x="12.9" y="34" width="42.2" height="2" id="1823810323"></rect>
              </g>
            </g>
          </svg>
        </div>
      </div>
    </div>
  </section>

  <!--tab layout End-->
  <!--section slider start-->
  <div class="slider__image-wrapper">
    <h2 class="slider__heading align-middle my-15">What our clients say about us</h2>
    <div class="divider__slider"></div>
    <div class="slider__container">
      <!--
        `swiper` class added alongside the legacy `swiper-container`: Swiper 11 renamed its root
        element class from `swiper-container` to `swiper` (the JS still accepts any element
        regardless of class, but the vendored CSS's layout rules — position, overflow, sizing —
        target `.swiper`, not `.swiper-container`). See carousel.ts / task report for details.
      -->
      <div class="swiper-container swiper">
        <div class="swiper-wrapper">
          <div class="swiper-slide">
            <div class="stars">*****</div>
            <p class="paragraph__slider my-25">
              Very good people who were very nice. They answered my many questions and did not mind
              explaining things over and over. Thank you guys for all your help. I recommend
              visiting them on the weekend, they are open on Saturday.
            </p>
            <span class="btn btn--primary btn--animated">Micheal Adamu</span>
          </div>
          <div class="swiper-slide">
            <div class="stars">*****</div>
            <p class="paragraph__slider my-25">
              I drove today (Saturday) from Prior Lake, about an hour drive, not expecting the
              process would be very easy. The staff was very nice and welcoming. I filed all
              documents within a short time. They say they will follow up with me. I recommend this
              office to help explain the complicated immigration rules.
            </p>
            <span class="btn btn--primary btn--animated">Vladmir Purchenka</span>
          </div>
          <div class="swiper-slide">
            <div class="stars">*****</div>
            <p class="paragraph__slider my-25">
              I completed everything I needed within an hour. I had Ayan help me and she was super
              helpful and understanding. I had lots of questions about what would happen next and
              she was very knowledgeable. Thank you to all in the office.
            </p>
            <span class="btn btn--primary btn--animated">Lucina Gail</span>
          </div>
        </div>
        <!-- Add Arrows -->
        <div class="swiper-button-next"></div>
        <div class="swiper-button-prev"></div>
      </div>
    </div>
  </div>

  <!--section who are we-->
  <section
    class="section section-about-company"
    style="padding-top: 10rem; padding-bottom: 10rem;"
    id="WhoAreWe"
  >
    <div class="about-container">
      <div class="about-content">
        <h2 class="heading__section who-are-we my-25">WHO ARE WE</h2>
        <p class="paragraph-section--3 paragraph-middle my-40">
          We are an immigrant-owned, family-run business established in {FOUNDED_YEAR}. From our
          Minneapolis office, we help individuals and families organize immigration and travel
          paperwork with personal, practical support.
        </p>
      </div>

      <div class="about-image"></div>
    </div>
  </section>

  <!--section-book-a-consultation-->

  <section class="section section-booking">
    <h3 class="heading__booking align-middle my-30 pu-70">Book a consultation</h3>
    <p class="paragraph-form align-middle my-40 max-410">
      Have a question? We&rsquo;re here to help. Send us a message and we&rsquo;ll get back to you.
    </p>

    <div class="form-wrapper">
      <ConsultForm subject="Booking" formId="form__booking" variant="orange" />
    </div>
  </section>

  <!--google map start-->
  <div class="map__wrapper">
    <Map />
  </div>
  <!--google map end-->

  <script>
    import '../scripts/carousel';
  </script>
</BaseLayout>

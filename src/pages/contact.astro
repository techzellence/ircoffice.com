---
import Icon from '../components/Icon.astro';
// Ported from the legacy contact.html body. Nav, Footer (with its own Disclaimer), and the
// BaseLayout head are supplied by BaseLayout.astro. Static port, same approach as Task 7/8: no
// page-level GSAP/jQuery script tags. No tabs on this page (contact.html never had a #tab-1
// block), so Tabs is not imported here.
//
// contact.html is the only one of the four legacy pages with a real visible map: the head's
// Google Maps JS API `<script>` tag (which carried the committed API key as a query param) and
// the body's `<div id="map"></div>` are both replaced by <Map /> (Leaflet, Task 6) — this removes
// the last committed copy of the Google Maps API key from the working tree.
//
// Duda page-editor cruft stripped from the three contact-information__row <a> wrappers (matching
// the Task 7 precedent of stripping dm_dont_rewrite_url/file/runtime_url/numeric id): none of it
// carried functional meaning here, only `href` did.
//
// Markup-balance fix (matching Task 7's h2/h3 close-tag precedent): legacy contact.html opens
// both `.contact-information-form` and `.form-box--information` but only closes one explicit
// `</div>` before `</section>`, relying on the browser's HTML5 parser to auto-close the other at
// `</section>`. Astro requires balanced tags, so both closing `</div>`s are present below.
import ConsultForm from '../components/ConsultForm.astro';
import Map from '../components/Map.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact Immigrant Resource Center | Minneapolis"
  description="Visit Immigrant Resource Center at 1 W Lake St, Suite 165, Minneapolis. Call (612) 822-5747 or ask about immigration paperwork and travel assistance."
  canonical="https://ircoffice.com/contact"
>
  <section class="section section-contact__block" style="padding-bottom: 10rem;">
    <div class="contact__information">
      <h1 class="contact-information__heading align-middle my-10">Contact Us</h1>

      <div class="divider__contact"></div>

      <!--row-1-->
      <div class="contact-information__row">
        <a href="#office-map" aria-label="View the office map">
          <Icon name="pin" />
        </a>

        <address class="row__text row-address">
          1 W Lake St Ste #165, Minneapolis, MN 55408, United States
        </address>
      </div>
      <!--row-1-end-->

      <!--row-2-->
      <a href="tel:(612) 822-5747">
        <div class="contact-information__row">
          <Icon name="phone" />

          <div class="row__text">(612) 822-5747</div>
        </div>
      </a>

      <!--row-3-->
      <a href="mailto:info@ircoffice.com">
        <div class="contact-information__row">
          <Icon name="mail" />

          <div class="row__text row__text--light">info@ircoffice.com</div>
        </div>
      </a>
      <!--row-3-end-->

      <div class="social-icon-block">
        <!-- Social links omitted pending real URLs from client (matches Nav/Footer) -->
      </div>
    </div>

    <div class="contact-information-form">
      <div class="form-box--information">
        <h2 class="heading-form__information my-15">Contact</h2>
        <p class="paragraph-form--information my-30">
          Call, email, or use the form below to ask about our services. Tell us briefly what you
          need help with. Please do not send Social Security numbers, passport numbers, or sensitive
          case records through this form.
        </p>
        <ConsultForm subject="Contact" formId="form__contact" />
      </div>
    </div>
  </section>

  <div class="divider" style="width: 100%; height: 10rem;"></div>

  <!--map start-->
  <div class="map__wrapper" id="office-map">
    <Map />
  </div>
  <!--map end-->
</BaseLayout>

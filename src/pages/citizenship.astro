---
// Ported from the legacy citizenship.html body. Nav, Footer (with its own Disclaimer), and the
// BaseLayout head are supplied by BaseLayout.astro. Static port, same approach as Task 7/8: the
// tab block is wrapped in <Tabs> exactly as src/pages/index.astro does, trigger anchors carry the
// flextabs__toggle class. No page-level GSAP/Swiper/jQuery script tags.
//
// citizenship.html has no visible <div id="map"> in the body (only the head's font stylesheet
// uses a googleapis.com host, not maps.googleapis.com) — there is no Map component usage on this
// page.
import ConsultForm from '../components/ConsultForm.astro';
import Tabs from '../components/Tabs.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Citizenship Application Help in Minneapolis | IRC"
  description="Citizenship and naturalization paperwork assistance in Minneapolis. Get help organizing Form N-400 and citizenship documents with Immigrant Resource Center."
  canonical="https://ircoffice.com/citizenship"
>
  <!--website hero image with form-->
  <header class="header header-flexbox">
    <div class="container-main">
      <div class="header__main-area">
        <div class="header-flexbox-content-left">
          <h1 class="heading__primary--greencard my-25">
            <span class="secondary-color-text">Citizenship <br />Applications</span>
          </h1>
          <p class="header__paragraph--greencard my-25" style="max-width: 500px;">
      Prepare your citizenship paperwork with practical support from our Minneapolis team.
    </p>
        </div>

        <!--form start-->
        <div class="form-box--greencard">
          <h2
            class="heading-form align-middle my-15"
            style="color: rgb(49, 49, 49); font-weight: 600;"
          >
            Get Help Today
          </h2>
          <p class="paragraph-form paragraph-form--greencard align-middle my-30">
            Tell us what paperwork you need help with.
          </p>
          <ConsultForm subject="Citizenship" formId="form__citizenship" />
        </div>
      </div>
    </div>
    <!--form end-->
  </header>

  <!--section what is green card-->
  <section class="section section-greencard-definition">
    <h2 class="heading__section align-middle my-15">What we can do for you</h2>
    <p class="paragraph-section align-middle my-30 max-width-600">
      We help prepare naturalization forms and organize supporting documents at your direction. Our
      team explains the paperwork process and the services we provide; USCIS decides each
      application.
    </p>
    <a href="#citizenship-services" class="btn--primary__blue btn--animated">Learn More</a>
  </section>

  <!--tab layout-->
  <section class="section section-greencard__services" id="citizenship-services">
    <h2 class="service__header my-20">Citizenship Application Process</h2>
    <p class="service__paragraph my-35">
      Learn about naturalization and documentation of citizenship acquired at birth. These are
      different processes, with different requirements.
    </p>
    <Tabs>
      <div class="tab-wrapper">
        <nav class="tabammount_2 tab-sticky">
          <a href="#tab-1" class="flextabs__toggle tab-name align-middle active">
            Apply for Citizenship
          </a>
          <a href="#tab-2" class="flextabs__toggle tab-name align-middle">
            Consular Report of Birth Abroad (CRBA)
          </a>
        </nav>
        <div class="all-tab-content-holder">
          <!--Tab 1 content  Start-->
          <div id="tab-1" class="tab-content-wrapper">
            <h3 class="heading__tab my-25">Naturalization — Form N-400</h3>
            <p class="my-35 tab-paragraph">
              Form N-400 is the application for naturalization. Eligibility can depend on permanent
              residence, physical presence, continuous residence, travel history, good moral
              character, and other requirements. Exceptions and special rules may apply.
            </p>
            <p class="my-35 tab-paragraph">
              Marriage to a U.S. citizen does not automatically make someone eligible to apply after
              three years. Review the USCIS requirements for your situation, and seek qualified
              legal advice if you are unsure.
            </p>
            <p class="my-35 tab-paragraph">Our team can help prepare your forms and organize information such as:</p>
            <ul class="green-card green-card--list my-35">
              <li>Your immigration records and prior USCIS notices</li>
              <li>Address and employment history</li>
              <li>Travel dates and time spent outside the United States</li>
              <li>Family information and relevant civil documents</li>
            </ul>
            <p class="my-35 tab-paragraph"><a class="tab-text-link" href="https://www.uscis.gov/n-400">Read Form N-400 instructions and eligibility guidance</a></p>
            <a href="/contact" class="btn btn--blue btn--animated">Ask about application assistance</a>
          </div>
          <!--Tab 1 content  End-->

          <!--Tab 2 content  Start-->
          <div id="tab-2" class="tab-content-wrapper">
            <h3 class="heading__tab my-25">Consular Report of Birth Abroad (CRBA)</h3>
            <p class="my-35 tab-paragraph">
              A Consular Report of Birth Abroad documents U.S. citizenship acquired at birth by an
              eligible child born outside the United States. It does not grant citizenship to a
              child who did not acquire it at birth.
            </p>
            <p class="my-35 tab-paragraph">
              Applications are handled through the U.S. Department of State. Follow the relevant
              embassy or consulate instructions for documentation, appointments, and the application
              process.
            </p>
            <p class="my-35 tab-paragraph">
              We can help organize documents for your application. Depending on the circumstances,
              these may include:
            </p>
            <ul class="green-card green-card--list my-35">
              <li>The child's birth certificate</li>
              <li>The parents' identity and citizenship documents</li>
              <li>Evidence of the U.S. citizen parent's residence or physical presence in the United States</li>
              <li>Marriage records and documents ending any prior marriages, where applicable</li>
            </ul>
            <p class="my-35 tab-paragraph"><a class="tab-text-link" href="https://travel.state.gov/content/travel/en/international-travel/while-abroad/birth-abroad.html">Read State Department guidance on birth abroad</a></p>
            <a href="/contact" class="btn btn--blue btn--animated">Ask about application assistance</a>
          </div>
          <!--Tab 2 Content End-->
        </div>
      </div>
    </Tabs>
  </section>


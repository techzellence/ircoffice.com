---
// Ported from the legacy greencard.html body. Nav, Footer (with its own Disclaimer), and the
// BaseLayout head are supplied by BaseLayout.astro (Nav/Footer chrome and the head's Google Maps
// script are not part of this page's markup at all). Static port, same approach as Task 7/8: the
// tab block is wrapped in <Tabs> exactly as src/pages/index.astro does, trigger anchors carry the
// flextabs__toggle class. No page-level GSAP/Swiper/jQuery script tags.
//
// greencard.html has no visible <div id="map"> in the body (only the head's font stylesheet uses
// a googleapis.com host, not maps.googleapis.com) — there is no Map component usage on this page.
import ConsultForm from '../components/ConsultForm.astro';
import Tabs from '../components/Tabs.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

---

<BaseLayout
  title="Green Card Application Help in Minneapolis | IRC"
  description="Get help preparing green card paperwork in Minneapolis, including adjustment of status and removal of conditions. Explore services and official USCIS resources."
  canonical="https://www.ircoffice.com/green-card"
>
  <!--website hero image with form-->
  <header class="header header-flexbox">
    <div class="container-main">
      <div class="header__main-area">
        <div class="header-flexbox-content">
          <h1 class="heading__primary--greencard align-middle my-25">
            <span class="secondary-color-text">Green Card<br />Applications</span>
          </h1>
          <p class="header__paragraph--greencard align-middle my-25">
            Get help preparing green card forms and organizing supporting documents at our
            Minneapolis office.
          </p>
        </div>
        <!--form-->
        <div class="form-box--greencard">
          <h2
            class="heading-form align-middle my-15"
            style="color: rgb(49, 49, 49); font-weight: 600;"
          >
            Get Help Today
          </h2>
          <p class="paragraph-form paragraph-form--greencard align-middle my-30">
            Tell us what paperwork you need help with.
          </p>
          <ConsultForm subject="Green Card" formId="form__greencard" />
        </div>
      </div>
    </div>
  </header>

  <!--section what is green card-->
  <section class="section section-greencard-definition">
    <h2 class="heading__section align-middle my-15">What is a green card?</h2>
    <p class="paragraph-section align-middle my-30 max-width-600">
      A green card is evidence of lawful permanent resident status in the United States. We assist
      with paperwork preparation; USCIS determines eligibility and decides applications.
    </p>
    <a href="#greencard-services" class="btn--primary__blue btn--animated">Learn More</a>
  </section>

  <!--tab layout-->
  <section class="section section-greencard__services" id="greencard-services">
    <h2 class="service__header my-20">Green Card Applications</h2>
    <p class="service__paragraph my-35">
      Different applications require different forms and supporting records. Explore the common
      processes below and use the linked USCIS instructions for current requirements and fees.
    </p>
    <Tabs>
      <div class="tab-wrapper">
        <nav class="tabammount_3 tab-sticky">
          <a href="#tab-1" class="flextabs__toggle tab-name align-middle active">
            Petition to Remove Conditions on Green Card
          </a>
          <a href="#tab-2" class="flextabs__toggle tab-name align-middle">Adjustment of status</a>
          <a href="#tab-3" class="flextabs__toggle tab-name align-middle">VAWA</a>
        </nav>
        <div class="all-tab-content-holder">
          <!--Tab 1 content  Start-->
          <div id="tab-1" class="tab-content-wrapper">
            <h3 class="heading__tab my-25">Removing conditions on residence — Form I-751</h3>
            <p class="my-35 tab-paragraph">
              Form I-751 is used to request removal of conditions on marriage-based permanent
              resident status. Filing requirements and timing depend on whether you file jointly or
              request a waiver; a single deadline or checklist does not cover every situation.
            </p>
            <p class="my-35 tab-paragraph">
              We can help organize your paperwork and supporting records. Review the current USCIS
              instructions, and seek qualified legal advice if you have questions about a waiver,
              separation, divorce, abuse, or a missed deadline.
            </p>
            <p class="my-35 tab-paragraph">Depending on your circumstances, supporting records may include:</p>
            <ul class="green-card green-card--list my-35">
              <li>Marriage records and documents about any prior marriages</li>
              <li>Records of a shared residence, finances, or insurance</li>
              <li>Photographs and other records of your life together</li>
              <li>Other evidence requested in the current form instructions</li>
            </ul>
            <p class="my-35 tab-paragraph"><a class="tab-text-link" href="https://www.uscis.gov/i-751">Read the official Form I-751 instructions</a></p>
            <a href="/contact" class="btn btn--blue btn--animated">Ask about application assistance</a>
          </div>
          <!--Tab 1 content  End-->

          <!--Tab 2 content  Start-->
          <div id="tab-2" class="tab-content-wrapper">
            <h3 class="heading__tab my-25">Adjustment of status — Form I-485</h3>
            <p class="my-35 tab-paragraph">
              Adjustment of status is an application process for eligible people in the United
              States seeking lawful permanent residence. Being in the United States does not, by
              itself, establish eligibility.
            </p>
            <p class="my-35 tab-paragraph">
              We help with form preparation and document organization at your direction. The
              documents you need depend on your application basis and history; the list below is a
              starting point, not a complete filing checklist.
            </p>
            <ul class="green-card green-card--list my-35">
              <li>Identity and civil records, such as birth and marriage certificates</li>
              <li>Immigration records, notices, and prior applications</li>
              <li>Relevant address, employment, and family information</li>
              <li>Supporting evidence specified by USCIS for your application category</li>
            </ul>
            <p class="my-35 tab-paragraph"><a class="tab-text-link" href="https://www.uscis.gov/i-485">Review Form I-485 requirements</a></p>
            <a href="/contact" class="btn btn--blue btn--animated">Ask about application assistance</a>
          </div>
          <!--Tab 2 Content End-->

          <!--Tab 3 Content Start-->
          <div id="tab-3" class="tab-content-wrapper">
            <h3 class="heading__tab my-25">VAWA self-petitions</h3>
            <p class="my-35 tab-paragraph">
              The Violence Against Women Act (VAWA) provides a self-petition process for certain
              people who have experienced abuse by a qualifying family member. Eligibility is
              specific to the relationship and circumstances; an approved petition does not
              automatically grant a green card.
            </p>
            <p class="my-35 tab-paragraph">
              Because these applications can involve safety concerns and complex legal questions,
              consult an immigration attorney or accredited representative for advice. Contact our
              office to ask about the document preparation assistance we can provide.
            </p>
            <p class="my-35 tab-paragraph">
              You do not need to describe abuse or send sensitive records through our website form.
              Ask how to discuss your paperwork through an appropriate channel.
            </p>
            <p class="my-35 tab-paragraph"><a class="tab-text-link" href="https://www.uscis.gov/humanitarian/abused-spouses-children-and-parents">Read USCIS guidance for abused spouses, children, and parents</a></p>
            <a href="/contact" class="btn btn--blue btn--animated">Ask about application assistance</a>
          </div>
          <!--Tab 3 Content End-->
        </div>
      </div>
    </Tabs>
  </section>


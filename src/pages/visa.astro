---
// Ported from the legacy visa.html body. Nav, Footer (with its own Disclaimer), and the
// BaseLayout head are supplied by BaseLayout.astro. Static port, same approach as Task 7/8: the
// tab block is wrapped in <Tabs> exactly as src/pages/index.astro does, trigger anchors carry the
// flextabs__toggle class. No page-level GSAP/Swiper/jQuery script tags.
//
// visa.html has no visible <div id="map"> in the body (only the head's font stylesheet uses a
// googleapis.com host, not maps.googleapis.com) — there is no Map component usage on this page.
//
// Duda page-editor cruft stripped from the two external <a> links in tab-2 (matching the Task 7
// precedent of stripping dm_dont_rewrite_url/file/runtime_url/numeric id): the legacy `value`,
// `type="url"`, and `data-runtime-url` attributes duplicated `href` and carried no meaning here.
import Icon from '../components/Icon.astro';
import ConsultForm from '../components/ConsultForm.astro';
import Tabs from '../components/Tabs.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Visa Application Help in Minneapolis | IRC"
  description="Visa paperwork assistance in Minneapolis for family petitions, fiancé(e) visas, and visitor visas. Find practical support and official application resources."
  canonical="https://ircoffice.com/visa"
>
  <!--website hero image with form-->
  <header class="header header-flexbox">
    <div class="container-main">
      <div class="header__main-area">
        <div class="header-flexbox-content-left">
          <h1 class="heading__primary--greencard my-25">
            <span class="secondary-color-text">Your travel plans.<br />The paperwork to match.</span>
          </h1>
          <p class="header__paragraph--greencard my-25" style="max-width: 400px;">
      Get help organizing visa applications and family petition paperwork. Start with your destination and purpose of travel, and we’ll explain the preparation support available.
    </p>
        </div>
        <!--form start-->
        <div class="form-box--greencard">
          <h2
            class="heading-form align-middle my-15"
            style="color: rgb(49, 49, 49); font-weight: 600;"
          >
            Talk with our team
          </h2>
          <p class="paragraph-form paragraph-form--greencard align-middle my-30">
            Share your plans or questions. We’ll explain the preparation services available and the next steps.
          </p>
          <ConsultForm subject="Visa" formId="form__visa" />
        </div>
        <!--form end-->
      </div>
    </div>
  </header>

  <!--section what is green card-->
  <section class="section section-greencard-definition">
    <h2 class="heading__section align-middle my-15">Help with visa paperwork</h2>
    <p class="paragraph-section align-middle my-30 max-width-600">
      Visa requirements depend on your nationality, destination, and purpose of travel. We help
      organize application information and supporting documents so you can prepare for the next
      step.
    </p>
    <a href="#visa-services" class="btn--primary__blue btn--animated">Learn More</a>
  </section>

  <!--tab layout-->
  <section class="section section-greencard__services" id="visa-services">
    <h2 class="service__header my-20">Visa Applications</h2>
    <p class="service__paragraph my-35">
      Explore family petitions, fiancé(e) visas, and visitor visas. Use the official resources below
      for current requirements, fees, and application instructions.
    </p>
    <Tabs>
      <div class="tab-wrapper">
        <nav class="tabammount_3 tab-sticky">
          <a href="#tab-1" class="flextabs__toggle tab-name align-middle active">
            Petition for Alien Relative
          </a>
          <a href="#tab-2" class="flextabs__toggle tab-name align-middle">
            Fiancé(e) visas
          </a>
          <a href="#tab-3" class="flextabs__toggle tab-name align-middle">Visitor visas</a>
        </nav>
        <div class="all-tab-content-holder">
          <!--Tab 1 content  Start-->
          <div id="tab-1" class="tab-content-wrapper">
            <h3 class="heading__tab my-25">Family petitions — Form I-130</h3>
            <p class="my-35 tab-paragraph">
              Form I-130, Petition for Alien Relative, is used to establish a qualifying family
              relationship for certain family-based immigration cases. The petitioner and
              beneficiary have different roles and documentation requirements.
            </p>
            <p class="my-35 tab-paragraph">
              Approval of a petition does not, by itself, grant a visa or permanent resident status.
              The next steps depend on the family category, visa availability, and the beneficiary's
              circumstances.
            </p>
            <p class="my-35 tab-paragraph">We help prepare forms and organize supporting records, including:</p>
            <ul class="green-card green-card--list my-35">
              <li>Evidence of the petitioner’s citizenship or permanent resident status</li>
              <li>Records establishing the family relationship</li>
              <li>Prior immigration notices and other documents required by the form instructions</li>
            </ul>
            <p class="my-35 tab-paragraph"><a class="tab-text-link" href="https://www.uscis.gov/i-130">Review the official Form I-130 instructions</a></p>
            <a href="/contact" class="btn btn--blue btn--animated">Ask about application assistance</a>
          </div>
          <!--Tab 1 content  End-->

          <!--Tab 2 content  Start-->
          <div id="tab-2" class="tab-content-wrapper">
            <h3 class="heading__tab my-25">Fiancé(e) petitions — Form I-129F</h3>
            <p class="my-35 tab-paragraph">
              The K-1 fiancé(e) visa process involves a petition, a visa application, and a decision
              about admission to the United States. Form I-129F is the petition used to begin the
              K-1 process for a qualifying fiancé(e) of a U.S. citizen.
            </p>
            <p class="my-35 tab-paragraph">
              Each stage has its own requirements. Review the USCIS guidance on eligibility, the
              intention to marry, and the steps after arrival before making plans.
            </p>
            <p class="my-35 tab-paragraph">
              Our team can help organize relationship records and prepare application paperwork at
              your direction. We do not control government decisions or processing times.
            </p>
            <p class="my-35 tab-paragraph"><a class="tab-text-link" href="https://www.uscis.gov/family/family-us-citizens/visas-fiancees-us-citizens">Read USCIS guidance on fiancé(e) visas</a></p>
            <a href="/contact" class="btn btn--blue btn--animated">Ask about application assistance</a>
          </div>
          <!--Tab 2 Content End-->

          <!--Tab 3 Content Start-->
          <div id="tab-3" class="tab-content-wrapper">
            <h3 class="heading__tab my-25">Visitor visas — business, tourism, and medical travel</h3>
            <p class="my-35 tab-paragraph">
              Visitor visas are for qualifying temporary visits. B-1 generally covers business
              visits, while B-2 covers tourism and other permitted visits, including medical
              treatment. A visitor visa is not permission to work in the United States.
            </p>
            <p class="my-35 tab-paragraph">
              The embassy or consulate handling your application provides current instructions.
              Requirements may vary, and a visa does not guarantee admission at the border.
            </p>
            <p class="my-35 tab-paragraph">
              We can help organize your application information and travel documents. For travel to
              other countries, contact us about destination-specific paperwork assistance.
            </p>
            <p class="my-35 tab-paragraph"><a class="tab-text-link" href="https://travel.state.gov/content/travel/en/us-visas/tourism-visit/visitor.html">Read State Department visitor visa guidance</a></p>
            <a href="/contact" class="btn btn--blue btn--animated">Ask about application assistance</a>
          </div>
          <!--Tab 3 Content End-->
        </div>
      </div>
    </Tabs>
  </section>

  <!--Section save time-->
  <section class="section section__save-time">
    <div class="facility__wrapper">
      <div class="facility__block">
        <Icon name="document" />
        <h4 class="facility__heading--small align-middle">Practical Help</h4>
      </div>

      <div class="facility__block">
        <Icon name="price" />
        <h4 class="facility__heading--small align-middle">Clear Pricing</h4>
      </div>

      <div class="facility__block">
        <Icon name="heart" />
        <h4 class="facility__heading--small align-middle">Friendly Support</h4>
      </div>

      <div class="facility__block">
        <Icon name="document" />
        <h4 class="facility__heading align-middle">Document Organization</h4>
      </div>
    </div>
  </section>
</BaseLayout>

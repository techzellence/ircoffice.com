---
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import { breadcrumbSchema, professionalServiceSchema } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
}

const SITE_ORIGIN = 'https://ircoffice.com';

const {
  title,
  description,
  canonical,
  ogType = 'website',
  ogImage = '/og-card.png',
} = Astro.props;

// Scrapers (WhatsApp, Facebook, X) require absolute URLs; a relative og:image
// is the usual reason a card validates in a tool but renders blank in a chat.
const ogImageUrl = new URL(ogImage, SITE_ORIGIN).href;

const businessSchema = professionalServiceSchema(SITE_ORIGIN);

// Breadcrumbs only make sense below the root; the home page is the root.
const pagePath = new URL(canonical).pathname;
const crumbs =
  pagePath === '/'
    ? null
    : breadcrumbSchema(SITE_ORIGIN, [
        { name: 'Home', path: '/' },
        { name: (title.split('|')[0] ?? title).trim(), path: pagePath },
      ]);

const rawBeaconToken: string | undefined = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
const beaconToken =
  rawBeaconToken && rawBeaconToken.trim() !== '' && rawBeaconToken !== 'undefined'
    ? rawBeaconToken
    : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Immigrant Resource Center" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Immigrant Resource Center — Immigration & Travel Services, Minneapolis"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" href="/img/favicon.ico" />
    <link rel="preconnect" href="https://fonts.gstatic.com" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cardo&family=Catamaran:wght@200;400;600;700&family=Prata&family=Raleway:wght@300;500;600;700&display=swap"
    />
    <link rel="stylesheet" href="/css/style.css" />
    <script
      src="https://challenges.cloudflare.com/turnstile/v0/api.js"
      async
      defer
      is:inline></script>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(businessSchema)} />
    {crumbs && <script type="application/ld+json" is:inline set:html={JSON.stringify(crumbs)} />}
    <slot name="head" />
  </head>
  <body>
    <Nav />
    <slot />
    <Footer />
    <script>
      import '../scripts/animation';
    </script>
    {
      // Without a token the beacon posts "undefined" to Cloudflare and logs a CORS error on
      // every page, so leave it out entirely until the token is configured.
      beaconToken && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: beaconToken })}
          is:inline
        />
      )
    }
  </body>
</html>

---
import BaseLayout from './BaseLayout.astro';
import { getCollection } from 'astro:content';
import { publicationDate, readingMinutes } from '../lib/blog';
import '../styles/blog.css';

interface Props {
  title: string;
  description: string;
  canonical: string;
  pubDate: Date;
  category: string;
  minutes: number;
  headings: { depth: number; slug: string; text: string }[];
  postId: string;
}

const { title, description, canonical, pubDate, category, minutes, headings, postId } = Astro.props;
const sections = headings.filter(h => h.depth === 2);
const related = (await getCollection('blog', ({ data }) => !data.draft))
  .filter(post => post.id !== postId)
  .sort((a, b) => Number(b.data.category === category) - Number(a.data.category === category) || a.data.title.localeCompare(b.data.title))
  .slice(0, 2);
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString().slice(0, 10),
  mainEntityOfPage: canonical,
  url: canonical,
  image: 'https://ircoffice.com/og-card.png',
  publisher: { '@id': 'https://ircoffice.com/#business' },
};
---

<BaseLayout
  title={`${title} | Immigrant Resource Center`}
  description={description}
  canonical={canonical}
  ogType="article"
>
  <script slot="head" type="application/ld+json" is:inline
    set:html={JSON.stringify(articleSchema).replace(/</g, '\\u003c')} />
  <main class="journal journal-post">
    <header class="article-header" id="top">
      <div class="journal-wrap">
        <a class="back-link" href="/blog"><span aria-hidden="true">←</span> All articles</a>
        <p class="eyebrow">{category}</p>
        <h1>{title}</h1>
        <p class="article-deck">{description}</p>
        <div class="article-byline"><span>Immigrant Resource Center</span><span aria-hidden="true">·</span><time datetime={pubDate.toISOString()}>{publicationDate(pubDate)}</time><span aria-hidden="true">·</span><span>{minutes} min read</span></div>
      </div>
    </header>
    <div class="journal-wrap reading-layout">
      <aside class="contents-sidebar">
        <details class="contents-panel" open>
          <summary>In this article</summary>
          <nav aria-label="Article sections"><ol>{sections.map(section => <li><a href={`#${section.slug}`}>{section.text}</a></li>)}</ol></nav>
        </details>
        <p class="reading-note">General information, with links to primary sources. For advice about your situation, speak with a qualified professional.</p>
      </aside>
      <article class="article-prose" aria-label={title}>
        <slot />
        <a class="back-link article-end" href="#top">Back to top <span aria-hidden="true">↑</span></a>
      </article>
    </div>
    <section class="journal-wrap related-reading" aria-labelledby="related-title">
      <div class="library-toolbar"><h2 id="related-title">Keep exploring</h2><a class="back-link" href="/blog">Browse all articles <span aria-hidden="true">→</span></a></div>
      <ul class="article-grid">
        {related.map(post => <li class="article-card"><a class="card-link" href={`/blog/${post.id}`}><div class="card-copy"><div class="card-meta"><span class="topic-label">{post.data.category}</span><span>{readingMinutes(post.body)} min read</span></div><h3>{post.data.title}</h3><p class="card-description">{post.data.description}</p><span class="card-action">Read article <svg class="journal-arrow" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 19 19 5M5 5h14v14" /></svg></span></div></a></li>)}
      </ul>
    </section>
  </main>
</BaseLayout>


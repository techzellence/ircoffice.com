---
interface Props {
  subject: string;
  formId: string;
  /**
   * Submit button color. ConsultForm renders on both dark navy panels (hero, booking
   * sections) and light page sections. `blue` (the default, `.btn--blue`) matches the
   * legacy behavior and reads fine on light backgrounds; `orange` (`.btn--primary`, the
   * same accent used by the "Learn More"/"Call Us" buttons) is required wherever the form
   * sits on a navy/dark panel, since a navy button on a navy panel is invisible.
   */
  variant?: 'blue' | 'orange';
}

const { subject, formId, variant = 'blue' } = Astro.props;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<form class="form" id={formId} data-surface={variant === 'orange' ? 'dark' : 'light'} novalidate>
  <div class="form__group">
    <label class="form__label" for={`${formId}-name`}>Name</label>
    <input class="form__input input-information" type="text" id={`${formId}-name`}
           name="name" autocomplete="name" maxlength="100" placeholder="Name" required />
  </div>
  <div class="form__group">
    <label class="form__label" for={`${formId}-email`}>Email</label>
    <input class="form__input input-information" type="email" id={`${formId}-email`}
           name="email" autocomplete="email" maxlength="254" placeholder="Email" required />
  </div>
  <div class="form__group">
    <label class="form__label" for={`${formId}-phone`}>Phone</label>
    <input class="form__input input-information" type="tel" id={`${formId}-phone`}
           name="phone" autocomplete="tel" maxlength="40" placeholder="Phone" required />
  </div>
  <div class="form__group">
    <label class="form__label" for={`${formId}-message`}>Message (optional)</label>
    <textarea class="form__input input-information" id={`${formId}-message`}
              name="message" maxlength="5000" rows="3"
              placeholder="How can we help?"></textarea>
  </div>

  <input type="hidden" name="subject" value={subject} />

  {/* Honeypot: hidden from humans, irresistible to bots. */}
  <div class="form__hp" aria-hidden="true">
    <label for={`${formId}-website`}>Leave this field empty</label>
    <input type="text" id={`${formId}-website`} name="website" tabindex="-1" autocomplete="off" />
  </div>

  <p class="form__privacy">Please leave out passport numbers and other sensitive records. <a href="/privacy">Privacy policy</a></p>

  <div class="cf-turnstile" data-size="compact" data-sitekey={turnstileSiteKey}></div>

  <p class="form__error" role="alert" hidden></p>
  <p class="form__success success-message" role="status"></p>

  <div class="form__group">
    <button type="submit" class:list={['btn', variant === 'orange' ? 'btn--primary' : 'btn--blue']}>
      Send Message
    </button>
  </div>
</form>

<style>
  .form__label { position: static; width: auto; height: auto; clip: auto; clip-path: none; overflow: visible; display: block; font-size: 15px; font-weight: 600; margin: 0 0 5px; transform: none; opacity: 1; }
  .form[data-surface="dark"] .form__label { color: #fff; }
  .form__privacy { font-size: 14px; line-height: 1.5; margin: 12px 0; }
  .form__privacy a { color: inherit; text-decoration: underline; }
  .form[data-surface="dark"] .form__privacy { color: #e4ebf0; }
  .form__hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form__error {
    margin: 1rem 0;
    font-family: 'Catamaran', sans-serif;
    font-size: 1.6rem;
    font-weight: 600;
    line-height: 1.4;
  }

  /* Brand orange in the pairing that passes WCAG AA on each surface: the dark orange on white,
     the light orange on the navy panels (the dark one is about 2:1 there). */
  .form[data-surface='light'] .form__error,
  .form[data-surface='light'] .form__success {
    color: #865019;
  }

  .form[data-surface='dark'] .form__error,
  .form[data-surface='dark'] .form__success {
    color: #e7b680;
  }
</style>

<script>
  import { messageForFailedSubmission, messageForInvalidField } from '../lib/form-feedback';

  interface TurnstileApi {
    reset(container?: string | HTMLElement): void;
  }

  class SubmissionError extends Error {
    constructor(
      readonly status: number,
      readonly body: unknown,
    ) {
      super(`Request failed with status ${status}`);
    }
  }

  document.querySelectorAll<HTMLFormElement>('form.form').forEach((form) => {
    const errorEl = form.querySelector<HTMLElement>('.form__error');
    const successEl = form.querySelector<HTMLElement>('.form__success');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const widget = form.querySelector<HTMLElement>('.cf-turnstile');

    const showError = (message: string): void => {
      if (!errorEl) return;
      errorEl.textContent = message;
      errorEl.hidden = false;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (errorEl) errorEl.hidden = true;

      // Catch an empty or malformed field here, before spending the single-use Turnstile token
      // and a rate-limit slot on a request the server would only reject.
      if (!form.checkValidity()) {
        const firstInvalid = form.querySelector<HTMLInputElement>('input:invalid');
        showError(messageForInvalidField(firstInvalid?.name));
        firstInvalid?.focus();
        return;
      }

      if (button) button.disabled = true;

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          body: new FormData(form),
        });

        if (!response.ok) {
          const body: unknown = await response.json().catch(() => null);
          throw new SubmissionError(response.status, body);
        }

        // Keep the status region in the document (so screen readers announce it) and drop
        // everything else.
        for (const child of Array.from(form.children)) {
          if (child !== successEl) child.remove();
        }
        if (successEl) {
          successEl.innerHTML =
            'Thank you for contacting us.<br />We will get back to you as soon as possible.';
        }
      } catch (error) {
        const status = error instanceof SubmissionError ? error.status : undefined;
        console.error('Contact form submission failed', {
          formId: form.id,
          status,
          message: error instanceof Error ? error.message : String(error),
        });
        showError(
          messageForFailedSubmission(status, error instanceof SubmissionError ? error.body : null),
        );
        // Turnstile tokens are single-use. Without a fresh one, every retry fails verification.
        const turnstile = (window as Window & { turnstile?: TurnstileApi }).turnstile;
        if (widget && turnstile) turnstile.reset(widget);
        if (button) button.disabled = false;
      }
    });
  });
</script>
